APP_NAME="FRTOON"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: SQLite (default, tanpa setup tambahan)
DB_CONNECTION=sqlite

# Jika ingin memakai MySQL (Laragon), hapus tanda # di bawah dan ganti DB_CONNECTION di atas menjadi mysql
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=frtoon
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
